# Environment Variables Example for cardroute-engine
# Copy this file to .env before starting the services

# Application Environment
SPRING_PROFILES_ACTIVE=local
PORT=8080
GRPC_PORT=9090

# PostgreSQL Configuration with pgvector
POSTGRES_DB=cardroute
POSTGRES_USER=cardroute_admin
POSTGRES_PASSWORD=cardroute_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cardroute

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring AI Configuration (Policy Ingestor)
OPENAI_API_KEY=your_openai_api_key_here
SPRING_AI_MODEL=gpt-4o

# Observability
PROMETHEUS_PORT=9090
